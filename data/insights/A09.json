    "S1": {
      "headline": "Developers expect smaller teams and uneven value from AI skill",
      "whatTheyDo": [
        {
          "tag": "learn-ai",
          "text": "Erik Reyes plans to ask his colleague Pradeep for perhaps an hour on Fridays to learn his AI coding workflow."
        },
        {
          "tag": "change-job",
          "text": "Wendy Lopez plans to look at council and hospital IT support jobs with stronger union coverage."
        },
        {
          "tag": "cut-spending",
          "text": "Fatima Yilmaz plans to stop Friday meals out with her partner Noor and cancel the gym."
        },
        {
          "tag": "collective-action",
          "text": "Aaron Patel plans to sign the union card and ask colleague Marcus and two others to sign."
        },
        {
          "tag": "keep-going",
          "text": "Uma Kowalski plans to ask Priya for permission to sit in on customer calls with shop owners."
        }
      ],
      "whatTheySay": [
        "**Wendy Lopez**: I'd post that firms use **AI to cut juniors** and keep the savings.",
        "**Gareth Kowalski**: I expect **Steady Disruption** to raise speed targets for code and client replies."
      ],
