    "S2": {
      "headline": "Fast thinking AI exposes software jobs and wages before physical robots arrive",
      "whatTheyDo": [
        {
          "tag": "change-job",
          "text": "Fatima Yilmaz considers driving with her cousin Emre as a temporary fallback before robots arrive."
        },
        {
          "tag": "seek-support",
          "text": "Wendy Lopez plans to claim unemployment benefit the week the Paybridge job ends."
        },
        {
          "tag": "cut-spending",
          "text": "Erik Reyes plans to cancel streaming and the gym and save the difference."
        },
        {
          "tag": "family-plans",
          "text": "Marco Dubois considers postponing the wedding and moving in with partner Ana’s parents if software work disappears."
        },
        {
          "tag": "collective-action",
          "text": "Aaron Patel plans to run tech workers’ union meetups rather than just attend them."
        }
      ],
      "whatTheySay": [
        "**Wendy Usman**: I'd say **2028 thinking AI** reaches our code before robots arrive around 2031.",
        "**Gareth Fischer**: I'd demand that governments **tax firms** that replace staff and fund people between jobs."
      ],
      "whatTheyThink": [
        "**199 of 243** privately see software jobs, coding or wages exposed by 2028.",
        "**25 of 243** privately weigh household income and savings runway.",
        "**10 of 243** privately doubt skills or another job guarantee earnings."
      ],
      "howTheyFeel": [
        "**219 of 243** are alarmed in this scenario.",
        "**18 of 243** are anxious in this scenario.",
        "**Average worry** is 4.05 for thin buffers and 3.83 for strong buffers, on a one to five scale."
      ],
      "differences": [
        {
          "group": "Money cushion",
          "text": "Average worry is 4.05 among 81 thin-cushion profiles, versus 3.83 among 81 strong-cushion profiles (1 calm to 5 panicked)."
