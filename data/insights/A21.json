    "S3": {
      "headline": "Five years makes a paid transition testable, not certain.",
      "whatTheyDo": [
        {
          "tag": "change-job",
          "text": "158 include **finding or changing work**, with paid vacancies remaining different from informal client interest."
        },
        {
          "tag": "retrain",
          "text": "148 include **study or retraining**, often requiring funded fees, paid practice or preserved household wages."
        },
        {
          "tag": "keep-going",
          "text": "101 include **continuing paid work** while another route is tested or until offered work ends."
        },
        {
          "tag": "save-more",
          "text": "92 include **saving or debt repayment** from earnings while income permits it."
        }
      ],
      "whatTheySay": [
        "Requests emphasize **funded routes** and real supervisors, rather than treating a certificate as a job.",
        "People distinguish **billed client work** from free pilot calls or unpriced promises of a new role."
      ],
      "whatTheyThink": [
        "Private **desk work fears** persist; a different title or location does not necessarily protect thinking tasks.",
        "For some, **paid client service** or hands-on work is a possible bridge, contingent on real demand."
      ],
      "howTheyFeel": [
        "**177 are anxious**, 15 alarmed and nine uneasy; none is calm or panicked.",
        "The **3.03 average worry** exceeds the plateau’s 1.78, despite additional preparation time."
      ],
      "segments": {
        "least": {
          "name": "More time available",
          "story": "Nine profiles are uneasy, the calmest mood present; seven have strong cushions and two have moderate cushions."
        },
        "most": {
          "name": "Expected wage gaps",
          "story": "15 profiles are alarmed; their cushions include eight thin, four moderate and three strong."
        }
      },
      "differences": [
        {
          "group": "Money cushion",
          "text": "Mean worry is **3.11 for thin cushions** (72 profiles), versus 2.94 for strong cushions (63)."
        },
        {
          "group": "Adaptability",
          "text": "Mean worry is **3.21 for resistant profiles**, versus 2.91 for adaptive profiles (67 in each group)."
        }
      ],
      "quotes": [
        {
          "id": "A21-32212",
          "name": "Yusuf Jensen",
          "text": "A useful answer is not automatically a paid role."
        },
        {
          "id": "A21-11111",
          "name": "Jade Rossi",
          "text": "Seeing AGI five years off is like seeing a wave coming from far off: you can at least walk up the beach."
        }
      ],
