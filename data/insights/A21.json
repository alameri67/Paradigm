    "S2": {
      "headline": "Fast desk losses outrun savings and replacement jobs.",
      "whatTheyDo": [
        {
          "tag": "change-job",
          "text": "181 include **finding or changing work**; actual vacancies and adequate written terms often gate a move."
        },
        {
          "tag": "save-more",
          "text": "105 include **saving or debt repayment** while wages continue, before using reserves after income loss."
        },
        {
          "tag": "seek-support",
          "text": "93 include **seeking support**, such as eligible income help or temporary arrangements for household bills."
        },
        {
          "tag": "cut-spending",
          "text": "85 include **cutting spending**, distinguishing cancelled purchases from new recurring savings."
        }
      ],
      "whatTheySay": [
        "People ask for **written pay dates** and retained source records before accounting posts disappear.",
        "Some seek **income help** or representation; eligibility and a funded replacement job remain uncertain."
      ],
      "whatTheyThink": [
        "**AI skill** can lose its wage advantage when the software no longer needs a human operator.",
        "**Cash reserves** can delay a household crisis without guaranteeing another accounting salary."
      ],
      "howTheyFeel": [
        "**174 are alarmed**, 24 anxious and three panicked; none is calm or uneasy.",
        "Average worry reaches **3.90**, with accounting exposed before the later hands-on robot date."
      ],
      "segments": {
        "least": {
          "name": "Room to respond",
          "story": "The 24 anxious profiles form the calmer end; 20 have strong cushions, and none has a thin cushion."
        },
        "most": {
          "name": "Rapid wage loss",
          "story": "Three panicked and 174 alarmed profiles form the most worried end, including all 72 profiles with thin cushions."
        }
      },
      "differences": [
        {
          "group": "Money cushion",
          "text": "Mean worry is **4.04 for thin cushions** (72 profiles), versus 3.68 for strong cushions (63)."
        },
        {
          "group": "Adaptability",
          "text": "Mean worry is **4.01 for resistant profiles**, versus 3.75 for adaptive profiles (67 in each group)."
        }
      ],
      "quotes": [
        {
          "id": "A21-32132",
          "name": "Beth Rahman",
          "text": "Standing in a care building does not protect an accounts desk from AGI."
        },
        {
          "id": "A21-13313",
          "name": "Sara Larsen",
          "text": "A year of savings can cover my rent; a year of savings cannot guarantee another accountant's salary."
        }
      ],
