{
  "code": "A21",
  "job": "Accountant",
  "interviews": 201,
  "overview": [
    "These **201 simulated accountants** are fictional profiles, not survey respondents or employment forecasts.",
    "Coverage is **81 early-career profiles**, 81 mid-career and 39 late-career profiles; this partial set is not the final balanced grid.",
    "Worry runs from **1 calm** to **5 panicked**; plans describe hypothetical responses, often conditional on actual paid opportunities."
  ],
  "scenarios": {
    "S0": {
      "headline": "Small tools leave ordinary money pressures in place.",
      "whatTheyDo": [
        {
          "tag": "keep-going",
          "text": "190 include **continuing paid accounting work**, often keeping checks against original records."
        },
        {
          "tag": "save-more",
          "text": "132 include **saving or debt repayment**; new deposits depend on wages remaining available."
        },
        {
          "tag": "learn-ai",
          "text": "23 include **learning AI tools**, alongside existing habits that are not new training."
        }
      ],
      "whatTheySay": [
        "Public comments favor **traceable records** and someone who can explain an incorrect charge.",
        "Some request **pay reviews** while describing software as a limited aid to existing work."
      ],
      "whatTheyThink": [
        "Limited **household reserves** can matter more than the small software improvement.",
        "**Job continuity** can coexist with worries about rent, client fees or a firm’s sale."
      ],
      "howTheyFeel": [
        "**102 are calm**, 42 uneasy and 57 anxious; none is alarmed or panicked.",
        "**Existing bill pressure** remains part of the mood, even when AI adds little."
      ],
      "segments": {
        "least": {
          "name": "Comfortable current budgets",
          "story": "All 102 calm profiles have moderate or strong cushions; none of the 72 thin-cushion profiles is calm."
        },
        "most": {
          "name": "Tight household margins",
          "story": "The most worried mood is anxious: 56 of the 57 profiles in that group have thin cushions."
        }
      },
      "differences": [
        {
          "group": "Money cushion",
          "text": "Mean worry is **2.78 for thin cushions** (72 profiles), versus 1.03 for strong cushions (63)."
        },
        {
          "group": "Adaptability",
          "text": "Mean worry is **1.90 for resistant profiles**, versus 1.72 for adaptive profiles (67 in each group)."
        }
      ],
