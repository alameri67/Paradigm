    "S4": {
      "headline": "A decade widens options while current bills still need wages.",
      "whatTheyDo": [
        {
          "tag": "change-job",
          "text": "160 include **finding or changing work**, often conditional on later income need and an actual funded role."
        },
        {
          "tag": "keep-going",
          "text": "138 include **continuing paid work**, rather than choosing an exit from age or a new title alone."
        },
        {
          "tag": "save-more",
          "text": "137 include **saving or debt repayment** while wages and essential bills allow it."
        }
      ],
      "whatTheySay": [
        "Some seek **written income estimates** before reducing hours or choosing a retirement date.",
        "Others ask for **tested paid demand** before relying on a new service or career path."
      ],
      "whatTheyThink": [
        "Unconfirmed **retirement income** is not spendable cash; age and savings do not establish an adequate pension.",
        "Some see **another career** within reach; others still cannot finance change without wages.",
        "**Current household bills** remain binding where pay is low or the cash cushion is thin."
      ],
      "howTheyFeel": [
        "**115 are uneasy**, 75 anxious and 11 calm; none is alarmed or panicked.",
        "**Present security** and later exposure can coexist; ten years of warning does not require a calm mood."
      ],
      "segments": {
        "least": {
          "name": "Present financial security",
          "story": "Eleven profiles are calm; eight have strong cushions, two moderate and one thin."
        },
        "most": {
          "name": "Continuing wage worries",
          "story": "75 profiles are anxious, the most worried mood present; 54 have thin cushions despite the longer horizon."
        }
      },
      "differences": [
        {
          "group": "Money cushion",
          "text": "Mean worry is **2.74 for thin cushions** (72 profiles), versus 2.05 for strong cushions (63)."
        },
        {
          "group": "Adaptability",
          "text": "Mean worry is **2.46 for resistant profiles**, versus 2.15 for adaptive profiles (67 in each group)."
        }
      ],
      "quotes": [
        {
          "id": "A21-32122",
          "name": "Karl Yilmaz",
          "text": "Ten years on a calendar does not fill a rent envelope."
        },
        {
          "id": "A21-13312",
          "name": "Karl Evans",
          "text": "A tax-dispute trial that only works because staff work unpaid evenings has failed."
        }
      ],
